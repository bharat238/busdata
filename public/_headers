# Cache-Control headers for BusData PWA
# Prevent caching of HTML shell to ensure updates are picked up immediately
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# Allow aggressive caching of hashed static assets (JS, CSS, images)
# These have content hashes in filenames, so they're immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache icons and other static resources
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
